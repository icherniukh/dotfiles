<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>dev.dotfiles.zsh-history-backup</string>
  <key>ProgramArguments</key>
  <array><string>{{ .chezmoi.homeDir | html }}/.scripts/backup-zsh-history-weekly</string></array>
  <key>EnvironmentVariables</key>
  <dict><key>PATH</key><string>/usr/bin:/bin</string></dict>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key><integer>0</integer>
    <key>Hour</key><integer>12</integer>
    <key>Minute</key><integer>0</integer>
  </dict>
  <key>Umask</key><integer>63</integer>
  <key>ProcessType</key><string>Background</string>
  <key>StandardOutPath</key><string>{{ .chezmoi.homeDir | html }}/Library/Logs/zsh-history-backup.log</string>
  <key>StandardErrorPath</key><string>{{ .chezmoi.homeDir | html }}/Library/Logs/zsh-history-backup.log</string>
</dict>
</plist>
