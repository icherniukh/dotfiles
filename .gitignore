.DS_Store
.AppleDouble
.LSOverride

# Local-only files (not shared)
local/

# If you experiment with stow adoption locally
.stow-adopt-*/


# Claude Code - personal settings
.claude/
local/.claude/

# Secrets - never commit actual values
zsh/.config/zsh/secrets.zsh
dot_config/zsh/secrets.zsh
dot_config/zsh/local.zsh


# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
