.DS_Store
.AppleDouble
.LSOverride

# Local-only files (not shared)
local/

# If you experiment with stow adoption locally
.stow-adopt-*/


# Claude Code - personal settings
.claude/
local/.claude/

# Secrets - never commit actual values
zsh/.config/zsh/secrets.zsh
dot_config/zsh/secrets.zsh
dot_config/zsh/local.zsh
dot_config/mise/conf.d/host.toml


# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key

# Serena
.serena/
.beads.gate.lock

# Machine-local agent settings and generated bytecode
.kiro/
__pycache__/
*.pyc

# Rejected polling mitigation: retained locally, not part of managed dotfiles.
dot_scripts/executable_watch-zsh-history
private_Library/private_LaunchAgents/dev.dotfiles.zsh-history-watch.plist.tmpl
tests/zsh_history_watch_check.py
