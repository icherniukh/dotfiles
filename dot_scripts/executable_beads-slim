#!/usr/bin/env bash
set -euo pipefail

if [[ $# -eq 0 ]]; then
  set -- .
fi

python3 - "$@" <<'PY'
from pathlib import Path
import json
import sys

prime = """# Beads

- Use `bd` only for long-horizon tracked work.
- Core: `bd ready`, `bd show <id>`, `bd create ...`, `bd update <id> --claim`, `bd close <id>`.
- Avoid `bd edit` in agent sessions.
- Use `bd remember` only for evergreen facts not already captured in issue descriptions.
- Update issue state before ending work.
"""

start = '<!-- BEGIN BEADS INTEGRATION'
end = '<!-- END BEADS INTEGRATION -->'

for raw in sys.argv[1:]:
    repo = Path(raw).expanduser().resolve()
    beads = repo / '.beads'
    if not beads.is_dir():
        print(f'skip {repo}: no .beads/')
        continue

    prime_path = beads / 'PRIME.md'
    prime_path.write_text(prime)
    print(f'prime {prime_path}')

    exclude = repo / '.git' / 'info' / 'exclude'
    if exclude.exists():
        lines = exclude.read_text().splitlines()
        if '.beads/PRIME.md' not in lines:
            with exclude.open('a') as f:
                if exclude.stat().st_size and not exclude.read_text().endswith('\n'):
                    f.write('\n')
                f.write('.beads/PRIME.md\n')
            print(f'exclude {exclude}')

    # .beads/PRIME.md above is what bd prime actually shows each session now,
    # so a static block repeating the same thing in the doc files is dead
    # weight -- strip it instead of shrinking it.
    for rel in ('AGENTS.md', 'CLAUDE.md', 'GEMINI.md', 'docs/AGENTS.md'):
        path = repo / rel
        if not path.exists():
            continue
        txt = path.read_text()
        if start in txt and end in txt:
            a = txt.index(start)
            b = txt.index(end) + len(end)
            tail = txt[b:]
            if tail.startswith('\n\n'):
                tail = tail[1:]
            new_txt = txt[:a].rstrip('\n') + '\n' + tail.lstrip('\n')
            path.write_text(new_txt)
            print(f'strip {path}')

    # Codex native hooks refresh bd context on SessionStart, PreCompact,
    # PostCompact, and UserPromptSubmit. The last one refires on every
    # single prompt, not just at boundaries where context can actually go
    # stale -- drop it. The compact hooks only need memories, not the full
    # dump -- add --memories-only.
    codex_hooks = repo / '.codex' / 'hooks.json'
    if codex_hooks.exists():
        data = json.loads(codex_hooks.read_text())
        hooks = data.get('hooks', {})
        changed = False

        for event in ('PreCompact', 'PostCompact'):
            for entry in hooks.get(event, []):
                for h in entry.get('hooks', []):
                    cmd = h.get('command', '')
                    if cmd.startswith('bd codex-hook') and '--memories-only' not in cmd:
                        h['command'] = cmd + ' --memories-only'
                        changed = True

        if 'UserPromptSubmit' in hooks:
            del hooks['UserPromptSubmit']
            changed = True

        if changed:
            codex_hooks.write_text(json.dumps(data, indent=2) + '\n')
            print(f'tune {codex_hooks}')
PY
