#!/usr/bin/env bash
# Run hk secret scans on chezmoi source without walking live .claude/ caches.
#
# Usage:
#   hk-dotfiles-secrets
#       → gitleaks + detect_private_key (default; safe for dotfiles source)
#   hk-dotfiles-secrets check --all
#   hk-dotfiles-secrets check --step check_merge_conflict --all -q
#
# Do NOT run `hk check --step gitleaks` directly in ~/proj/dotfiles — gitleaks
# uses --source . and false-positives on .claude/ agent caches on disk.
set -euo pipefail

ROOT="${HK_DOTFILES_ROOT:-$(chezmoi source-path 2>/dev/null || echo "$HOME/proj/dotfiles")}"
STAGING_SCRIPT="$ROOT/dot_scripts/executable_hk-chezmoi-staging"

if [[ ! -x "$STAGING_SCRIPT" ]]; then
  echo "hk-dotfiles-secrets: missing $STAGING_SCRIPT" >&2
  exit 1
fi
if ! command -v hk >/dev/null 2>&1; then
  echo "hk-dotfiles-secrets: hk not on PATH" >&2
  exit 1
fi
if [[ ! -f "$ROOT/hk.pkl" ]]; then
  echo "hk-dotfiles-secrets: missing $ROOT/hk.pkl" >&2
  exit 1
fi

cleanup() { [[ -n "${STAGING:-}" && -d "${STAGING:-}" ]] && rm -rf "$STAGING"; }
trap cleanup EXIT

STAGING="$("$STAGING_SCRIPT" "$ROOT")"
cd "$STAGING"

if [[ $# -eq 0 ]]; then
  exec hk check --step gitleaks --step detect_private_key --all
fi

case "$1" in
  -h|--help)
    sed -n '2,11p' "$0"
    exit 0
    ;;
  check|fix|run)
    cmd="$1"
    shift
    exec hk "$cmd" "$@"
    ;;
  *)
    exec hk check "$@"
    ;;
esac