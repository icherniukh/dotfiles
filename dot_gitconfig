[merge]
    conflictstyle = diff3
	# tool = bbdiff

[commit]
    # template = ~/.git-commit-template.txt
    cleanup = strip

[alias]
    dag = log --graph --format='format:%C(yellow)%h%C(reset) %C(blue)%an <%ae>%C(reset) %C(magenta)%cr%C(reset)%C(auto)%d%C(reset)%n%s' --date-order
    lg = log --pretty=format:"%C(red)%h\\ %C(yellow)%ad%Cgreen%d\\ %Creset%s%C(cyan)\\ [%cn]" --decorate --date=short
    gl = log --pretty='%Cred%h%Creset %C(yellow)%d%Creset%<(70,trunc)%s %Cgreen(%cr)%Creset %C(cyan)[%<(15,trunc)%an]%Creset'
    l = !git log --pretty=format:'%Cred---------------------------------------------------------------%n%C(red)%h %C(yellow)%d %Cgreen(%ci) %C(red)<%ae>%Creset%n%s%n%n%b%n' --abbrev-commit --date=relative --graph --date-order --stat --color | less -cR
    lc = log --decorate --color --oneline --branches --remotes=backup --not --remotes
    last = log -1 HEAD
    lol = log --graph --decorate --pretty=oneline --abbrev-commit
    lola = log --graph --decorate --pretty=oneline --abbrev-commit --all
    hist = log --pretty=format:"%h %ad | %s%d [%an]" --graph --date=short

    lf = log ORIG_HEAD.. --stat --no-merges

    st = status --short -b
    std=diff --stat -r
    sd=diff --stat -r
    unstage = reset HEAD --
    branchname = "!git rev-parse --abbrev-ref HEAD"

    lastdiff = git diff HEAD~1..HEAD
    ddiff = difftool -d
    sdiff = diff --staged
    diffstat = diff --stat -r
    d = !git diff --color origin/mainline | less -cR
    # pushup = "push --set-upstream origin %1"

    econf = config --global -e
    undo = reset HEAD~1 --mixed
    save = !git add -A && git commit -m 'SAVEPOINT'
    wip = commit -am "WIP"
    amend = commit -a --amend
    wipe = !git add -A && git commit -qm 'WIPE SAVEPOINT' && git reset HEAD~1 --hard

    pullre = pull --rebase
    pullm = "!git stash save && git fetch origin mainline && git pull --rebase origin mainline && git stash pop"
    main = checkout mainline
    mm = "!git checkout mainline && git pull"
    m = "!git checkout -B $(git rev-parse --abbrev-ref HEAD)_WIP && git add -A && git commit -qm 'SAVEPOINT' && sleep 0.35 && git checkout mainline && git pull"
